# ==============================================================================
# COMUNIDADE RESILIENTE - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Domínio Oficial em Produção: https://cp2p.democracias.org
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# NUNCA comite chaves privadas, senhas reais ou segredos no repositório.

# ------------------------------------------------------------------------------
# 1. Configuração Central do Domínio Oficial (Ambiente de Produção)
# ------------------------------------------------------------------------------
# Em produção, utilize obrigatoriamente https:// e wss:// sem portas locais
APP_DOMAIN=cp2p.democracias.org
APP_URL=https://cp2p.democracias.org
PUBLIC_URL=https://cp2p.democracias.org
API_URL=https://cp2p.democracias.org/api
WS_URL=wss://cp2p.democracias.org
BOOTSTRAP_URL=https://cp2p.democracias.org
BOOTSTRAP_WS_URL=wss://cp2p.democracias.org
PUBLIC_BOOTSTRAP_ADDRESS=wss://cp2p.democracias.org

# Defina como 'production' na VPS e 'development' em máquinas locais de teste
NODE_ENV=development

# Origens CORS permitidas (separadas por vírgula em produção)
CORS_ALLOWED_ORIGINS=https://cp2p.democracias.org

# ------------------------------------------------------------------------------
# 2. Identificação do Nó Local (Desktop / Pessoal)
# ------------------------------------------------------------------------------
NODE_ID=node_desktop_meu_computador
ROLE=Membro
# Papéis permitidos: Membro, Moderador, Administrador
USERNAME=meu_usuario

# Senha de proteção local da chave privada (NUNCA utilize senhas padrão como senha123)
PASSWORD=

# ------------------------------------------------------------------------------
# 3. Portas de Rede Locais (Processo Interno)
# ------------------------------------------------------------------------------
# Porta HTTP para a interface web / API local
HTTP_PORT=5001

# Porta P2P para escuta de conexões WebSocket diretas entre computadores
P2P_PORT=6001

# Host de escuta (127.0.0.1 para segurança local ou 0.0.0.0 para rede local/Docker)
HOST=127.0.0.1

# Abrir automaticamente o navegador ao iniciar o daemon desktop
AUTO_OPEN=true

# Diretório para armazenamento dos bancos SQLite e identidades
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 4. VPS Bootstrap & Descoberta Distribuída (Múltiplas VPS Suportadas)
# ------------------------------------------------------------------------------
# Em produção: utilize wss://cp2p.democracias.org
# Em desenvolvimento: utilize ws://127.0.0.1:4001
BOOTSTRAP_NODES=wss://cp2p.democracias.org

# ------------------------------------------------------------------------------
# 5. Resolução de NAT e STUN (RFC 5389)
# ------------------------------------------------------------------------------
# Servidores STUN públicos para descobrir IP reflexivo e tipo de NAT
STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302,stun.cloudflare.com:3478

# ------------------------------------------------------------------------------
# 6. Notificações Web Push (VAPID Zero-Knowledge)
# ------------------------------------------------------------------------------
# Chaves VAPID geradas automaticamente pelo nó caso omitidas.
# Notificações transmitem apenas alertas genéricos, sem conteúdo confidencial.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@democracias.org

# ------------------------------------------------------------------------------
# 7. Modo de Operação da VPS (Apenas quando executando src/server/vps_bootstrap.js)
# ------------------------------------------------------------------------------
VPS_PORT=4001
VPS_HOST=0.0.0.0
RELAY_RATE_LIMIT=60
